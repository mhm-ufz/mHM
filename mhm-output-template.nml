! Output configuration
!
! Output namelists for mHM, mLM, and mRM.

! mHM output configuration
&output_mhm
  ! Output deflate level
  output_deflate_level = 6
  ! Output double precision
  output_double_precision = .false.
  ! Output time reference
  output_time_reference = 2
  ! Output time step
  output_frequency = -2
  ! Interception
  out_interception = .false.
  ! Snowpack
  out_snowpack = .false.
  ! Layered Soil Water Content
  out_SWC = .false.
  ! Layered Relative Soil Saturation
  out_SM = .false.
  ! Mean Relative Soil Saturation
  out_SM_all = .false.
  ! Reservoir of Sealed areas
  out_sealedSTW = .false.
  ! Reservoir of Unsaturated areas
  out_unsatSTW = .false.
  ! Reservoir of Saturated areas
  out_satSTW = .false.
  ! Potential Evapotranspiration
  out_PET = .false.
  ! Mean actual Evapotranspiration
  out_aET_all = .false.
  ! Total Discharge
  out_Q = .false.
  ! Direct Runoff
  out_QD = .false.
  ! Fast Interflow
  out_QIf = .false.
  ! Slow Interflow
  out_QIs = .false.
  ! Baseflow
  out_QB = .false.
  ! Groundwater Recharge
  out_recharge = .false.
  ! Soil Infiltration
  out_soil_infil = .false.
  ! Neutrons
  out_neutrons = .false.
  ! Actual Evapotranspiration from Soil Layers
  out_aET_layer = .false.
  ! Effective Precipitation
  out_preEffect = .false.
  ! Snow Melt
  out_Qsm = .false.
/

! mLM output configuration
&output_mlm
  ! Output deflate level
  output_deflate_level = 6
  ! Output double precision
  output_double_precision = .false.
  ! Output time reference
  output_time_reference = 2
  ! Output time step
  output_frequency = -1
  ! Use station time-series layout for lake-point output
  output_timeseries = .false.
  ! Lake level
  out_lake_level = .false.
  ! Lake surface area
  out_lake_surface_area = .false.
  ! Lake volume
  out_lake_volume = .false.
  ! Lake groundwater storage
  out_lake_gw_storage = .false.
  ! Lake inflow
  out_lake_inflow = .false.
  ! Lake precipitation
  out_lake_precipitation = .false.
  ! Lake evaporation
  out_lake_evaporation = .false.
  ! Lake seepage
  out_lake_seepage = .false.
  ! Lake baseflow
  out_lake_baseflow = .false.
  ! Lake spill
  out_lake_spill = .false.
  ! Lake outflow
  out_lake_outflow = .false.
/

! mRM output configuration
&output_mrm
  ! Output deflate level
  output_deflate_level = 6
  ! Output double precision
  output_double_precision = .false.
  ! Output time reference
  output_time_reference = 2
  ! Output time step
  output_frequency = -1
  ! Flow accumulation
  out_facc = .true.
  ! Upstream area
  out_upstream_area = .true.
  ! Reach water surface area
  out_reach_surface_area = .true.
  ! Routed Streamflow
  out_Qrouted = .true.
  ! Routed Temperature
  out_RivTemp = .true.
  ! Routed thermal power
  out_Erouted = .true.
/

# Create a writable run root while sharing immutable fixture inputs.
function(mhm_stage_run source_dir run_dir)
  file(MAKE_DIRECTORY "${run_dir}/examples")
  foreach(name fixtures domain_01/input domain_02/input)
    get_filename_component(parent "${run_dir}/examples/${name}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    if(NOT EXISTS "${run_dir}/examples/${name}")
      file(CREATE_LINK "${source_dir}/examples/${name}" "${run_dir}/examples/${name}" SYMBOLIC RESULT link_result)
      if(NOT link_result STREQUAL "0")
        file(COPY "${source_dir}/examples/${name}" DESTINATION "${parent}")
      endif()
    endif()
  endforeach()
  foreach(domain domain_01 domain_02)
    file(MAKE_DIRECTORY "${run_dir}/examples/${domain}/output" "${run_dir}/examples/${domain}/restart")
    file(GLOB domain_nmls "${source_dir}/examples/${domain}/*.nml")
    file(COPY ${domain_nmls} DESTINATION "${run_dir}/examples/${domain}")
  endforeach()
  file(GLOB example_nmls "${source_dir}/examples/*.nml")
  file(COPY ${example_nmls} DESTINATION "${run_dir}/examples")
  file(COPY "${source_dir}/test_nml" DESTINATION "${run_dir}")
  file(GLOB templates "${source_dir}/mhm-*-template.nml" "${source_dir}/mhm-template.nml")
  file(COPY ${templates} DESTINATION "${run_dir}")
  file(COPY "${source_dir}/src/tests/test_parameters_expected.nml" DESTINATION "${run_dir}")
endfunction()

if(DEFINED SOURCE_DIR AND DEFINED RUN_DIR)
  mhm_stage_run("${SOURCE_DIR}" "${RUN_DIR}")
endif()

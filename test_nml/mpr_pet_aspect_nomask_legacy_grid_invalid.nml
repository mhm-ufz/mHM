&config_project
  n_domains = 1
  n_geo_units      = 10
/

&config_processes
  pet = -2
/

&config_time
  sim_start(1)  = "1990-01-01 00:00"
  eval_start(1) = "1990-01-01 00:00"
  sim_end(1)    = "1990-01-03 00:00"
/


&config_resolution
  hydro(1) = 4000.0
/

&config_input
  slope_path(1)     = "examples/fixtures/input.nc"
  aspect_path(1)    = "examples/fixtures/aspect.asc"
  geo_class_path(1) = "examples/fixtures/geology_class.asc"
  soil_class_path(1)= "examples/fixtures/soil_class.asc"
  lai_class_path(1) = "examples/fixtures/LAI_class.asc"
  pre_path(1)       = "examples/domain_01/input/meteo/pre.nc"
  temp_path(1)      = "examples/domain_01/input/meteo/tavg.nc"
  pet_path(1)       = "examples/domain_01/input/meteo/pet.nc"
/

&config_meteo
/

&config_mpr
  n_layers(1) = 2
  soil_db_mode(1)          = 0
  tillage_depth(1)         = 200
  soil_depth(1,1)          = 200
  fracSealed_cityArea(1)   = 0.6
  land_cover_path(1)       = "examples/fixtures/lc_static.nc"
  land_cover_var(1)        = "land_cover"
  lai_time_step(1)         = 0
/

&config_mhm
/

&config_lut
  soil_lut_path(1)         = "examples/domain_01/input/morph/soil_classdefinition.txt"
  geo_lut_path(1)          = "examples/domain_01/input/morph/geology_classdefinition.txt"
  lai_lut_path(1)          = "examples/domain_01/input/morph/LAI_classdefinition.txt"
/

&config_project
  n_domains = 1
  n_geo_units = 10
/

&config_processes
  routing = 2
  lake = -1
/

&config_time
  sim_start(1) = "1990-01-02"
  eval_start(1) = "1990-01-02"
  sim_end(1) = "1990-01-03"
/

&config_resolution
  route(1) = 6000.0
/

&config_input
  runoff_path(1) = "examples/fixtures/runoff.nc"
  runoff_var(1) = "Q"
/

&config_lake
  read_restart(1) = .true.
  restart_input_path(1) = "mrm_lake_restart_mlm.nc"
/

&config_mrm
  max_route_step(1) = 3600
  output_path(1) = "mrm_lake_restart_only.nc"
  read_restart(1) = .true.
  restart_input_path(1) = "mrm_lake_restart_mrm.nc"
/

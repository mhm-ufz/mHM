&config_project
  n_domains   = 1
  n_geo_units = 10
/

&config_processes
  interception = 1
  pet = -2
/

&config_time
  sim_start(1)  = "1990-01-01 00:00"
  eval_start(1) = "1990-01-01 00:00"
  sim_end(1)    = "1990-01-03 00:00"
/

&config_resolution
  hydro(1) = 4000.0
/

&config_input
  time_stamp_location(1) = 2
  fdir_path(1)           = "examples/fixtures/input.nc"
  dem_path(1)            = "examples/fixtures/input.nc"
  lake_definition_path(1) = "examples/fixtures/lake_outlets.nc"
  slope_path(1)          = "test_domain/input/morph/slope.asc"
  aspect_path(1)         = "test_domain/input/morph/aspect.asc"
  geo_class_path(1)      = "test_domain/input/morph/geology_class.asc"
  soil_class_path(1)     = "test_domain/input/morph/soil_class.asc"
  lai_class_path(1)      = "test_domain/input/morph/LAI_class.asc"
  pre_path(1)            = "examples/fixtures/pre_daily_aligned.nc"
  pet_path(1)            = "examples/fixtures/pet_daily_aligned.nc"
/

&config_meteo
  frac_night_pre(:,1) = 0.46, 0.50, 0.52, 0.51, 0.48, 0.50, 0.49, 0.48, 0.52, 0.56, 0.50, 0.47
  frac_night_pet(:,1) = 0.10, 0.10, 0.10, 0.10, 0.10, 0.10, 0.10, 0.10, 0.10, 0.10, 0.10, 0.10
/

&config_mpr
  n_layers(1)              = 2
  soil_db_mode(1)          = 0
  tillage_depth(1)         = 200
  soil_depth(1,1)          = 200
  fracSealed_cityArea(1)   = 0.6
  land_cover_path(1)       = "examples/fixtures/lc_static.nc"
  land_cover_var(1)        = "land_cover"
  lai_time_step(1)         = 0
  soil_lut_path(1)         = "test_domain/input/morph/soil_classdefinition.txt"
  geo_lut_path(1)          = "test_domain/input/morph/geology_classdefinition.txt"
  lai_lut_path(1)          = "test_domain/input/morph/LAI_classdefinition.txt"
  write_restart(1)         = .true.
  restart_output_path(1)   = "mpr_lake_mask_restart.nc"
/

&config_mhm
/

&config_project
  n_domains      = 1
  n_geo_units      = 10
/

&config_processes
  routing        = 2
/

&config_time
  sim_start(1)   = "1990" ! "1990-01-01 00:00"
  eval_start(1)  = "1990" ! "1990-01-01 00:00"
  sim_end(1)     = "1991" ! "1991-01-01 00:00"
/

&config_input
  runoff_path(1) = "examples/fixtures/runoff.nc"
  fdir_path(1)   = "examples/fixtures/input.nc"
  runoff_var(1)  = "Q"
/

&config_mrm
  resolution(1)  = 12000.0
  max_route_step(1) = 3600 ! [s] truncate routing steps to 1 hour
  output_path(1) = "mrm_output_1990-1991.nc"
  write_restart(1) = .true.
  restart_output_path(1) = "mrm_restart_1991.nc"
  scc_gauges_path(1) = "examples/fixtures/scc_gauges.nc"
/

! Lake case -2 precipitation/PET balance: compact or topology-bearing restart coverage.

&config_project
  n_domains = 1
  n_geo_units = 10
/

&config_processes
  routing = 2
  lake = -2
/

&config_time
  sim_start(1)  = "1990-01-02"
  eval_start(1) = "1990-01-02"
  sim_end(1)    = "1990-01-03"
/

&config_resolution
  hydro(1) = 24000.0
  route(1) = 6000.0
/

&config_input
  runoff_path(1)          = "examples/fixtures/runoff.nc"
  runoff_var(1)           = "Q"
  meteo_mask_path(1)      = "examples/domain_01/input/meteo/mask.nc"
  pet_path(1) = "examples/domain_01/input/meteo/pet.nc"
  pre_path(1)             = "examples/domain_01/input/meteo/pre.nc"
/

&config_meteo
  frac_night_pet(:,1) = 12*0.1
  frac_night_pre(:,1) = 0.46,0.50,0.52,0.51,0.48,0.50,0.49,0.48,0.52,0.56,0.50,0.47
/

&config_mlm
  n_lakes(1)            = 1
  output_path(1)        = "mlm_lake_case_minus2_topology_only_mlm.nc"
  bathymetry_type(1,1)  = 2
  natural(1,1)          = .true.
  evaporation_method    = 2
  varying_albedo        = .false.
  read_restart(1)       = .true.
  restart_input_path(1) = "mlm_lake_case_minus2_topology_mlm.nc"
/

&config_mrm
  max_route_step(1)     = 3600
  output_path(1)        = "mlm_lake_case_minus2_topology_only.nc"
  read_restart(1)       = .true.
  restart_input_path(1) = "mlm_lake_case_minus2_topology_mrm.nc"
/

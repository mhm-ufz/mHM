&config_project
  n_domains = 1
  n_geo_units = 10
/

&config_processes
  routing = 2
/

&config_time
  sim_start(1) = "1990-02-01"
  eval_start(1) = "1990-02-01"
  sim_end(1) = "1990-03-01"
/

&config_resolution
/

&config_input
  runoff_path(1) = "examples/fixtures/runoff.nc"
  runoff_var(1) = "Q"
/

&config_mrm
  max_route_step(1) = 3600
  output_poi_path(1) = "mrm_poi_output_test2.nc"
  read_restart(1) = .true.
  restart_input_path(1) = "mrm_poi_restart_test.nc"
/

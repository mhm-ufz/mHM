&config_project
  n_domains = 1
  n_geo_units = 10
/

&config_processes
  routing = 2
/

&config_time
  sim_start(1) = "1990-01-01 00:00"
  eval_start(1) = "1990-01-01 00:00"
  sim_end(1) = "1990-01-02 00:00"
/

&config_resolution
  route(1) = 12000.0
/

&config_input
  runoff_path(1) = "examples/fixtures/runoff.nc"
  runoff_var(1) = "Q"
  fdir_path(1) = "examples/fixtures/input.nc"
/

&config_mrm
  max_route_step(1) = 86400
  output_path(1) = "mrm_coarse_output.nc"
/

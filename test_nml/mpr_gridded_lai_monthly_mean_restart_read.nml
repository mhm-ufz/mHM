&config_project
  n_domains = 1
  n_geo_units      = 10
/

&config_processes
  interception = 1
/

&config_time
  sim_start(1)  = "1990-01-01 00:00"
  eval_start(1) = "1990-01-01 00:00"
  sim_end(1)    = "1990-03-03 00:00"
/


&config_resolution
  hydro(1) = 4000.0
/

&config_input
/

&config_meteo
/

&config_mpr
  n_layers(1) = 2
  soil_db_mode(1)          = 0
  tillage_depth(1)         = 200
  soil_depth(1,1)          = 200
  fracSealed_cityArea(1)   = 0.6
  lai_time_step(1)         = 1
  soil_lut_path(1)         = "test_domain/input/morph/soil_classdefinition.txt"
  geo_lut_path(1)          = "test_domain/input/morph/geology_classdefinition.txt"
  read_restart(1)          = .true.
  restart_input_path(1)    = "mpr_gridded_lai_monthly_mean_restart.nc"
/

&config_mhm
/

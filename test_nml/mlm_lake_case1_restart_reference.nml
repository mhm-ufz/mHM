! Case-1 restart round-trip, part 2 of 3: REFERENCE (Input-backed continuation).
! Reads the restarts written by mlm_lake_case1_restart_write and continues one day
! WITH the full lake Input still present. This is the reference the restart-only
! run (part 3) must reproduce bit-for-bit.

&config_project
  n_domains = 1
  n_geo_units = 10
/

&config_processes
  routing = 2
  lake = 1
/

&config_time
  sim_start(1)  = "1990-01-02"
  eval_start(1) = "1990-01-02"
  sim_end(1)    = "1990-01-03"
/

&config_resolution
  route(1) = 6000.0
/

&config_input
  runoff_path(1)          = "examples/fixtures/runoff.nc"
  runoff_var(1)           = "Q"
  fdir_path(1)            = "examples/fixtures/input.nc"
  dem_path(1)             = "examples/fixtures/input.nc"
  lake_definition_path(1) = "examples/fixtures/lake_outlets.nc"
/

&config_mlm
  output_path(1)        = "mlm_lake_case1_restart_reference_mlm.nc"
  bathymetry_type(1,1)  = 2
  natural(1,1)          = .true.
  read_restart(1)       = .true.
  restart_input_path(1) = "mlm_lake_case1_restart_mlm.nc"
/

&config_mrm
  max_route_step(1)     = 3600
  output_path(1)        = "mlm_lake_case1_restart_reference.nc"
  read_restart(1)       = .true.
  restart_input_path(1) = "mlm_lake_case1_restart_mrm.nc"
/

  ! PTF constant above 66.5 percent sand
  ! Component order: value, optimize, lower_bound, upper_bound
  ptf_upper_66_5_constant = 0.8907, .true., 0.8, 0.9
  ! PTF clay multiplier above 66.5 percent sand
  ! Component order: value, optimize, lower_bound, upper_bound
  ptf_upper_66_5_clay = -0.001, .true., -0.0012, -0.0008
  ! PTF bulk-density multiplier above 66.5 percent sand
  ! Component order: value, optimize, lower_bound, upper_bound
  ptf_upper_66_5_bulk_density = -0.322, .true., -0.35, -0.3
  ! PTF constant for saturated hydraulic conductivity
  ! Component order: value, optimize, lower_bound, upper_bound
  ptf_ks_constant = -0.585, .true., -1.2, -0.285
  ! PTF sand multiplier for saturated hydraulic conductivity
  ! Component order: value, optimize, lower_bound, upper_bound
  ptf_ks_sand = 0.0125, .true., 0.006, 0.026
  ! PTF clay multiplier for saturated hydraulic conductivity
  ! Component order: value, optimize, lower_bound, upper_bound
  ptf_ks_clay = 0.0063, .true., 0.003, 0.013
  ! Root-fraction coefficient for forest
  ! Component order: value, optimize, lower_bound, upper_bound
  root_fraction_forest = 0.97, .true., 0.9, 0.999
  ! Root-fraction coefficient for impervious areas
  ! Component order: value, optimize, lower_bound, upper_bound
  root_fraction_impervious = 0.93, .true., 0.9, 0.95
  ! Root-fraction coefficient for pervious areas
  ! Component order: value, optimize, lower_bound, upper_bound
  root_fraction_pervious = 0.02, .true., 0.001, 0.09
  ! Shape factor partitioning effective precipitation into runoff and infiltration
  ! Component order: value, optimize, lower_bound, upper_bound
  infiltration_shape_factor = 1.75, .true., 1.0, 4.0
/


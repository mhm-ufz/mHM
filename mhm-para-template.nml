! Parameter configuration
!
! Process parameter namelists for mHM.

! Interception - Case 1
&interception_1
  ! Multiplier relating LAI to interception storage
  ! Component order: value, optimize, lower_bound, upper_bound
  canopy_interception_factor = 0.15, .true., 0.15, 0.4
/

! Snow - Case 1
&snow_1
  ! Threshold for rain and snow partitioning [degC]
  ! Component order: value, optimize, lower_bound, upper_bound
  snow_threshold_temperature = 1.0, .true., -2.0, 2.0
  ! Degree-day factor for forest [m degC-1]
  ! Component order: value, optimize, lower_bound, upper_bound
  degree_day_factor_forest = 1.5, .true., 0.0001, 4.0
  ! Degree-day factor for impervious areas [m degC-1]
  ! Component order: value, optimize, lower_bound, upper_bound
  degree_day_factor_impervious = 0.5, .true., 0.0, 1.0
  ! Degree-day factor for pervious areas [m degC-1]
  ! Component order: value, optimize, lower_bound, upper_bound
  degree_day_factor_pervious = 0.5, .true., 0.0, 2.0
  ! Precipitation-dependent degree-day factor increase [degC-1]
  ! Component order: value, optimize, lower_bound, upper_bound
  degree_day_factor_precipitation = 0.5, .true., 0.1, 0.9
  ! Maximum degree-day factor for forest [m degC-1]
  ! Component order: value, optimize, lower_bound, upper_bound
  max_degree_day_factor_forest = 3.0, .true., 0.0, 8.0
  ! Maximum degree-day factor for impervious areas [m degC-1]
  ! Component order: value, optimize, lower_bound, upper_bound
  max_degree_day_factor_impervious = 3.5, .true., 0.0, 8.0
  ! Maximum degree-day factor for pervious areas [m degC-1]
  ! Component order: value, optimize, lower_bound, upper_bound
  max_degree_day_factor_pervious = 4.0, .true., 0.0, 8.0
/

! Soil moisture - Case 1
&soil_moisture_1
  ! Organic matter content for forest
  ! Component order: value, optimize, lower_bound, upper_bound
  organic_matter_forest = 7.0, .true., 5.0, 10.0
  ! Organic matter content for impervious areas
  ! Component order: value, optimize, lower_bound, upper_bound
  organic_matter_impervious = 0.5, .true., 0.0, 1.0
  ! Organic matter content for pervious areas
  ! Component order: value, optimize, lower_bound, upper_bound
  organic_matter_pervious = 2.5, .true., 1.0, 5.0
  ! PTF constant below 66.5 percent sand
  ! Component order: value, optimize, lower_bound, upper_bound
  ptf_lower_66_5_constant = 0.788, .true., 0.75, 0.8
  ! PTF clay multiplier below 66.5 percent sand
  ! Component order: value, optimize, lower_bound, upper_bound
  ptf_lower_66_5_clay = 0.001, .true., 0.0008, 0.0012

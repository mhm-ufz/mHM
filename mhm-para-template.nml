  ! Component order: value, optimize, min, max
  ptf_ks_constant = -0.585, .true., -1.2, -0.285
  ! PTF sand multiplier for saturated hydraulic conductivity
  ! Component order: value, optimize, min, max
  ptf_ks_sand = 0.0125, .true., 0.006, 0.026
  ! PTF clay multiplier for saturated hydraulic conductivity
  ! Component order: value, optimize, min, max
  ptf_ks_clay = 0.0063, .true., 0.003, 0.013

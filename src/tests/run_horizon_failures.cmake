foreach(scenario IN ITEMS gap convention internal fixed zero-internal negative-bottom)
  execute_process(COMMAND "${TEST_EXECUTABLE}" "${scenario}"
    WORKING_DIRECTORY "${RUN_DIRECTORY}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if("${result}" STREQUAL "0")
    message(FATAL_ERROR "Horizon failure '${scenario}' unexpectedly succeeded")
  endif()
  set(diagnostic "fixed internal interfaces")
  if(scenario STREQUAL "gap")
    set(diagnostic "non-contiguous bounds")
  elseif(scenario STREQUAL "zero-internal")
    set(diagnostic "increase strictly")
  elseif(scenario STREQUAL "negative-bottom")
    set(diagnostic "terminal bound must not lie above")
  elseif(scenario STREQUAL "convention")
    set(diagnostic "incompatible fixed/variable")
  endif()
  string(FIND "${stdout}\n${stderr}" "${diagnostic}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Horizon failure '${scenario}' missed '${diagnostic}': ${stdout}\n${stderr}")
  endif()
endforeach()

if(DEFINED RESTART_EXECUTABLE)
  foreach(scenario IN ITEMS interfaces fixed-bottom cosmic)
    execute_process(COMMAND "${RESTART_EXECUTABLE}" "${scenario}"
      WORKING_DIRECTORY "${RUN_DIRECTORY}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    set(diagnostic "fixed internal interfaces")
    if(scenario STREQUAL "cosmic")
      set(diagnostic "regenerate MPR parameters")
    endif()
    string(FIND "${stdout}\n${stderr}" "${diagnostic}" found)
    if("${result}" STREQUAL "0" OR found EQUAL -1)
      message(FATAL_ERROR "Restart failure '${scenario}' missed '${diagnostic}': ${stdout}\n${stderr}")
    endif()
  endforeach()
endif()

module test_lake_soil_lut
  use funit
  use mo_kind, only: dp, i4
  use mo_constants, only: nodata_dp
  use mo_mlm_mpr, only: lake_read_soil_texture_lut

  implicit none
  private

  public :: test_reads_mode0_class_horizon_lut
  public :: test_reads_mode1_texture_lut
  public :: test_mode1_textures_not_missing

  character(*), parameter :: mode0_path = "lake_soil_lut_mode0.txt"
  character(*), parameter :: mode1_path = "lake_soil_lut_mode1.txt"

contains

  !> Write a 7-column class/horizon (soil_db_mode 0) LUT: two classes, two horizons each. Only the
  !> uppermost horizon (horizon 1) is retained.
  subroutine write_mode0_lut()
    integer :: u
    open(newunit=u, file=mode0_path, status="replace", action="write")
    write(u, "(a)") "nSoil_Types 2"
    write(u, "(a)") "CLASS HORIZON UD LD CLAY SAND BD"
    ! class 1
    write(u, "(a)") "1 1 0.0 0.3 20.0 40.0 1.4"
    write(u, "(a)") "1 2 0.3 0.6 25.0 35.0 1.5"
    ! class 2
    write(u, "(a)") "2 1 0.0 0.3 10.0 70.0 1.3"
    write(u, "(a)") "2 2 0.3 0.6 15.0 60.0 1.4"
    close(u)
  end subroutine write_mode0_lut

  !> Write a 4-column texture (soil_db_mode 1) LUT: two classes, one texture record each.
  subroutine write_mode1_lut()
    integer :: u
    open(newunit=u, file=mode1_path, status="replace", action="write")
    write(u, "(a)") "nSoil_Types 2"
    write(u, "(a)") "CLASS CLAY SAND BD"
    write(u, "(a)") "1 20.0 40.0 1.4"
    write(u, "(a)") "2 10.0 70.0 1.3"
    close(u)
  end subroutine write_mode1_lut

  !> Mode-0 (7-column) LUT reads the top-horizon sand/clay per class.
  @test
  subroutine test_reads_mode0_class_horizon_lut()
    integer(i4) :: n_classes
    real(dp), allocatable :: sand(:), clay(:)
    call write_mode0_lut()
    call lake_read_soil_texture_lut(mode0_path, n_classes, sand, clay)
    @assertEqual(2, n_classes, message="mode-0 header class count")
    @assertEqual(40.0_dp, sand(1), tolerance=1.0e-9_dp, message="class 1 top-horizon sand")
    @assertEqual(20.0_dp, clay(1), tolerance=1.0e-9_dp, message="class 1 top-horizon clay")
    @assertEqual(70.0_dp, sand(2), tolerance=1.0e-9_dp, message="class 2 top-horizon sand")
    @assertEqual(10.0_dp, clay(2), tolerance=1.0e-9_dp, message="class 2 top-horizon clay")
  end subroutine test_reads_mode0_class_horizon_lut

  !> Mode-1 (4-column) LUT reads the single-texture sand/clay per class -- the regression for the
  !> reader that previously assumed the 7-column layout.
  @test
  subroutine test_reads_mode1_texture_lut()
    integer(i4) :: n_classes
    real(dp), allocatable :: sand(:), clay(:)
    call write_mode1_lut()
    call lake_read_soil_texture_lut(mode1_path, n_classes, sand, clay)
    @assertEqual(2, n_classes, message="mode-1 header class count")
    @assertEqual(40.0_dp, sand(1), tolerance=1.0e-9_dp, message="class 1 sand from 4-column record")
    @assertEqual(20.0_dp, clay(1), tolerance=1.0e-9_dp, message="class 1 clay from 4-column record")
    @assertEqual(70.0_dp, sand(2), tolerance=1.0e-9_dp, message="class 2 sand from 4-column record")
    @assertEqual(10.0_dp, clay(2), tolerance=1.0e-9_dp, message="class 2 clay from 4-column record")
  end subroutine test_reads_mode1_texture_lut

  !> Mode-1 textures must no longer come back as the missing-value sentinel (the reported defect).
  @test
  subroutine test_mode1_textures_not_missing()
    integer(i4) :: n_classes
    real(dp), allocatable :: sand(:), clay(:)
    call write_mode1_lut()
    call lake_read_soil_texture_lut(mode1_path, n_classes, sand, clay)
    @assertTrue(all(sand > nodata_dp + 1.0_dp), message="mode-1 sand is populated, not missing")
    @assertTrue(all(clay > nodata_dp + 1.0_dp), message="mode-1 clay is populated, not missing")
  end subroutine test_mode1_textures_not_missing

end module test_lake_soil_lut

foreach(mode frozen_ks frozen_kbf frozen_length frozen_config_ks unversioned unsupported_version case_conflict missing_footprint
  missing_ks_parameters missing_kbf_parameters missing_length_parameters missing_definition requested_topology missing_support)
  execute_process(COMMAND "${TEST_EXECUTABLE}" "${mode}" WORKING_DIRECTORY "${RUN_DIRECTORY}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(mode MATCHES "frozen")
    set(diagnostic "parameters generating restored")
  elseif(mode STREQUAL "unversioned" OR mode STREQUAL "unsupported_version")
    set(diagnostic "unsupported lake restart format; regenerate")
  elseif(mode STREQUAL "case_conflict")
    set(diagnostic "lake process case conflicts with restart")
  elseif(mode MATCHES "missing_(footprint|.*parameters|definition)")
    set(diagnostic "restart is missing required field")
  elseif(mode STREQUAL "requested_topology")
    set(diagnostic "restart_save_topology requires available")
  else()
    set(diagnostic "lake forcing requires compatible saved support")
  endif()
  if(status EQUAL 0 OR NOT "${output}${error}" MATCHES "${diagnostic}")
    message(FATAL_ERROR "${mode}: expected failure and diagnostic; status=${status}\n${output}${error}")
  endif()
endforeach()

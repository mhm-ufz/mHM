module test_river_upscaler
  use funit
  use mo_kind, only: i2, i4, i8, dp
  use mo_grid, only: grid_t, bottom_up
  use mo_netcdf, only: NcDataset, NcVariable
  use mo_river, only: river_t, sink, d8_E, d8_S
  use mo_river_upscaler, only: river_upscaler_t, upscale_legacy, upscale_flow
  use nml_config_mrm, only: nml_config_mrm_t
  use nml_helper, only: NML_OK

  implicit none
  private

  public :: test_legacy_and_flow_targets, test_flow_scc_endpoint, test_lake_labels, test_upscaling_config

contains

  @test
  subroutine test_legacy_and_flow_targets()
    type(grid_t), target :: fine_grid, coarse_grid
    type(river_t), target :: fine_river, legacy_river, flow_river
    type(river_upscaler_t) :: legacy_upscaler, flow_upscaler
    integer(i8) :: ids(6,2)
    integer(i2) :: fdir(12)
    real(dp) :: slope(12), lake_dem(12)
    real(dp), allocatable :: celerity(:)
    logical :: exists
    integer(i4), allocatable :: scc(:,:), leaving(:,:), stream(:,:), stream_sub(:,:)
    integer(i8), allocatable :: lake_map(:,:)
    type(NcDataset) :: nc
    type(NcVariable) :: nc_var

    call fine_grid%init(6_i4, 2_i4, cellsize=1.0_dp, y_direction=bottom_up)
    call coarse_grid%init(3_i4, 1_i4, cellsize=2.0_dp, y_direction=bottom_up)
    call fine_grid%gen_id_matrix(ids)

    ! Two rivers traverse the middle coarse cell. Its selected start is on the
    ! upper river, so the lower river reaches the sink without meeting it.
    fdir = d8_E
    fdir(ids(6,1)) = sink
    fdir(ids(5,2)) = d8_S
    fdir(ids(6,2)) = d8_S
    call fine_river%from_fdir(fdir, fine_grid)
    @assertEqual(fine_river%n_nodes, fine_river%points%n_points, message='D8 river owns one point per node')
    call fine_river%calc_order(root=.true.)
    call fine_river%calc_facc()
    lake_dem = 0.0_dp
    lake_dem(ids(1,1)) = 2.0_dp
    call fine_river%set_elevation(lake_dem)
    call fine_river%label_lakes([ids(6,1)], [3271_i8], [1.0_dp])

    ! Select the lower leaving cell in coarse cell 1 and the upper leaving
    ! cell in coarse cell 2; retain the lower sink in coarse cell 3.
    fine_river%facc(ids(2,1)) = 4_i4
    fine_river%facc(ids(2,2)) = 2_i4
    fine_river%facc(ids(4,1)) = 4_i4
    fine_river%facc(ids(4,2)) = 8_i4
    fine_river%facc(ids(6,1)) = 20_i4

    call legacy_upscaler%init( &
      fine_river=fine_river, coarse_river=legacy_river, coarse_grid=coarse_grid, &
      upscale_mode=upscale_legacy, length_percentile=0.0_dp, diagnostics_path='river_upscaler_diagnostics.nc')
    call flow_upscaler%init( &
      fine_river=fine_river, coarse_river=flow_river, coarse_grid=coarse_grid, &
      upscale_mode=upscale_flow, length_percentile=0.0_dp, retain_stream_mask=.true.)

    @assertEqual(2_i8, legacy_river%down(1), message='legacy connects to first entered coarse cell')
    @assertEqual(3_i8, flow_river%down(1), message='FLOW connects to reached downstream endpoint')
    @assertEqual(3_i8, legacy_river%down(2))
    @assertEqual(3_i8, flow_river%down(2))
    @assertEqual(0_i8, legacy_river%down(3))
    @assertEqual(0_i8, flow_river%down(3))
    @assertEqual(flow_river%n_nodes, flow_river%points%n_points, message='upscaled river owns one point per node')
    @assertEqual(fine_river%points%x(flow_upscaler%link_start(1)), flow_river%points%x(1), tolerance=1.e-12_dp)
    @assertEqual(fine_river%points%y(flow_upscaler%link_start(1)), flow_river%points%y(1), tolerance=1.e-12_dp)

    @assertEqual(ids(2,1), legacy_upscaler%link_start(1))
    @assertEqual(ids(6,1), legacy_upscaler%link_end(1))
    @assertEqual(ids(6,1), flow_upscaler%link_end(1))
    @assertEqual(4.0_dp, legacy_river%link_length(1), tolerance=1.e-12_dp, message='source edge included, endpoint edge excluded')
    @assertEqual(4.0_dp, flow_river%link_length(1), tolerance=1.e-12_dp)
    @assertEqual(0.0_dp, flow_river%link_length(3), tolerance=1.e-12_dp, message='sink length stays zero')
    @assertFalse(allocated(legacy_river%fdir), message='upscaling does not create coarse fdir')
    @assertFalse(allocated(flow_river%fdir), message='nonlocal graph is not projected to D8')
    @assertFalse(allocated(legacy_upscaler%stream_mask), message='stream mask is not retained by default')
    @assertTrue(allocated(flow_upscaler%stream_mask), message='requested stream mask is retained')
    @assertFalse(flow_upscaler%stream_mask(ids(1,1)), message='non-stream cells stay unmasked')
    @assertTrue(flow_upscaler%stream_mask(ids(2,1)), message='traced link starts are masked')
    @assertTrue(flow_upscaler%stream_mask(ids(5,2)), message='traced downstream links are masked')
    inquire(file='river_upscaler_diagnostics.nc', exist=exists)
    @assertTrue(exists, message='diagnostics are written during upscaling')
    nc = NcDataset('river_upscaler_diagnostics.nc', 'r')
    @assertTrue(nc%hasVariable('scc'))
    @assertTrue(nc%hasVariable('leaving'))
    @assertTrue(nc%hasVariable('stream'))
    @assertTrue(nc%hasVariable('stream_sub'))
    @assertTrue(nc%hasVariable('lake_map'))
    @assertTrue(nc%hasVariable('dem'))
    nc_var = nc%getVariable('scc')
    call nc_var%getData(scc)
    nc_var = nc%getVariable('leaving')
    call nc_var%getData(leaving)
    nc_var = nc%getVariable('stream')
    call nc_var%getData(stream)
    nc_var = nc%getVariable('stream_sub')
    call nc_var%getData(stream_sub)
    nc_var = nc%getVariable('lake_map')
    call nc_var%getData(lake_map)
    call nc%close()
    @assertEqual(1_i4, scc(1,1))
    @assertEqual(2_i4, leaving(2,1))
    @assertEqual(-1_i4, leaving(3,1))
    @assertEqual(2_i4, stream(2,1))
    @assertEqual(1_i4, stream(3,1))
    @assertEqual(1_i4, stream_sub(3,1))
    @assertEqual(0_i8, lake_map(1,1), message='cells above the maximum level remain outside lakes')
    @assertEqual(3271_i8, lake_map(2,1), message='diagnostics preserve the stable lake ID')
    call legacy_upscaler%calc_celerity(2.0_dp, celerity, constant_celerity=.true.)
    @assertEqual(2.0_dp, celerity(1), tolerance=1.e-12_dp)
    slope = 1.0_dp
    slope(ids(5,2)) = 100.0_dp
    call flow_upscaler%calc_celerity(2.0_dp, celerity, slope=slope)
    @assertTrue(allocated(celerity), message='variable celerity uses the retained stream mask')
    @assertEqual(0.2_dp, celerity(2), tolerance=1.e-12_dp)
  end subroutine test_legacy_and_flow_targets

  @test
  subroutine test_flow_scc_endpoint()
    type(grid_t), target :: fine_grid, coarse_grid
    type(river_t), target :: fine_river, coarse_river
    type(river_upscaler_t) :: upscaler
    integer(i8) :: ids(6,2)
    integer(i2) :: fdir(12)
    real(dp) :: gauges(1,2)

    call fine_grid%init(6_i4, 2_i4, cellsize=1.0_dp, y_direction=bottom_up)
    call coarse_grid%init(3_i4, 1_i4, cellsize=2.0_dp, y_direction=bottom_up)
    call fine_grid%gen_id_matrix(ids)
    fdir = d8_E
    fdir(ids(6,1)) = sink
    fdir(ids(5,2)) = d8_S
    fdir(ids(6,2)) = d8_S
    call fine_river%from_fdir(fdir, fine_grid)
    call fine_river%calc_order(root=.true.)
    call fine_river%calc_facc()
    fine_river%facc(ids(2,1)) = 4_i4
    fine_river%facc(ids(2,2)) = 2_i4
    fine_river%facc(ids(4,1)) = 4_i4
    fine_river%facc(ids(4,2)) = 8_i4
    fine_river%facc(ids(6,1)) = 20_i4

    ! The upper start in the middle coarse cell is also an SCC gauge.
    gauges(1,:) = [3.5_dp, 1.5_dp]
    call upscaler%init( &
      fine_river=fine_river, coarse_river=coarse_river, coarse_grid=coarse_grid, &
      scc_gauges=gauges, scc_latlon=.false., upscale_mode=upscale_flow, length_percentile=0.0_dp)

    @assertTrue(coarse_river%scc)
    @assertEqual(2_i8, upscaler%scc_coarse_gauges(1))
    @assertEqual(2_i8, coarse_river%down(1), message='upstream SCC trace terminates at gauge start')
    @assertEqual(5_i8, coarse_river%down(2), message='gauge trace follows fine river to downstream sink')
    @assertEqual(ids(4,2), upscaler%link_end(1))
    @assertEqual(ids(6,1), upscaler%link_end(2))
    @assertEqual(gauges(1,1), coarse_river%points%x(upscaler%scc_coarse_gauges(1)), tolerance=1.e-12_dp)
    @assertEqual(gauges(1,2), coarse_river%points%y(upscaler%scc_coarse_gauges(1)), tolerance=1.e-12_dp)
  end subroutine test_flow_scc_endpoint

  @test
  subroutine test_lake_labels()
    type(grid_t), target :: grid
    type(grid_t) :: land_grid, lake_grid
    type(river_t) :: river
    integer(i8) :: ids(6,1)
    integer(i2) :: fdir(6)
    integer(i8), parameter :: upper_id = 5000000001_i8, lower_id = 9000000002_i8
    integer(i8) :: expected(6)
    real(dp) :: dem(6)
    logical, allocatable :: land_packed(:), lake_packed(:)
    logical :: land_mask(6,1), lake_mask(6,1)

    call grid%init(6_i4, 1_i4, cellsize=1.0_dp, y_direction=bottom_up)
    call grid%gen_id_matrix(ids)
    fdir = d8_E
    fdir(ids(6,1)) = sink
    call river%from_fdir(fdir, grid)
    call river%calc_order(root=.true.)

    dem = [1.0_dp, 2.0_dp, 3.0_dp, 6.0_dp, 5.0_dp, 4.0_dp]
    call river%set_elevation(dem)
    call river%label_lakes( &
      [ids(3,1), ids(6,1)], [upper_id, lower_id], [3.0_dp, 5.0_dp])

    expected = [upper_id, upper_id, upper_id, 0_i8, lower_id, lower_id]
    @assertTrue(all(river%lake_map == expected), message='nested outlet catchments are disjoint and thresholded by maximum level')
    call river%lake_masks(land_packed, lake_packed)
    @assertTrue(all(land_packed .neqv. lake_packed), message='packed land and lake masks are complementary')
    @assertEqual(1, count(land_packed), message='only the cell above both lake levels remains land')
    @assertEqual(5, count(lake_packed), message='five cells belong to a lake')
    call grid%unpack_into(land_packed, land_mask)
    call grid%unpack_into(lake_packed, lake_mask)
    call grid%copy_to(land_grid, mask=land_mask, keep_sub_cell_area=.true.)
    call grid%copy_to(lake_grid, mask=lake_mask, keep_sub_cell_area=.true.)
    @assertEqual(1_i8, land_grid%ncells)
    @assertEqual(5_i8, lake_grid%ncells)
    @assertEqual(grid%nx, land_grid%nx)
    @assertEqual(grid%ny, lake_grid%ny)
    @assertTrue(all((land_grid%mask .or. lake_grid%mask) .eqv. grid%mask))
    @assertFalse(any(land_grid%mask .and. lake_grid%mask))
    call river%calc_length()
    call river%calc_slope()
    @assertEqual(100.0_dp, river%link_slope(4), tolerance=1.e-12_dp, message='link slope uses stored node elevation')
    call river%clean()
    @assertFalse(allocated(river%lake_map), message='river cleanup releases the lake map')
    @assertFalse(allocated(river%node_elevation), message='river cleanup releases node elevation')
  end subroutine test_lake_labels

  @test
  subroutine test_upscaling_config()
    type(nml_config_mrm_t) :: config
    integer :: status
    character(1024) :: errmsg

    status = config%init(errmsg)
    @assertEqual(NML_OK, status)
    @assertEqual(1_i4, config%upscale_mode(1), message='FLOW-like mode is the default')
    @assertEqual(40.0_dp, config%length_percentile(1), tolerance=1.e-12_dp)
    @assertFalse(config%scc_gauges_as_poi(1), message='SCC gauges are not POIs by default')
    @assertTrue(config%poi_timeseries(1), message='POI output defaults to time-major layout')
    @assertFalse(config%node_timeseries(1), message='node output defaults to node-major layout')

    status = config%set(upscale_mode=[2_i4], errmsg=errmsg)
    @assertEqual(NML_OK, status)
    status = config%is_valid(errmsg=errmsg)
    @assertTrue(status /= NML_OK, message='unknown upscaling mode is rejected')
    status = config%set(length_percentile=[-1.0_dp], errmsg=errmsg)
    @assertEqual(NML_OK, status)
    status = config%is_valid(errmsg=errmsg)
    @assertTrue(status /= NML_OK, message='negative length percentile is rejected')
    status = config%set(length_percentile=[101.0_dp], errmsg=errmsg)
    @assertEqual(NML_OK, status)
    status = config%is_valid(errmsg=errmsg)
    @assertTrue(status /= NML_OK, message='length percentile above 100 is rejected')
  end subroutine test_upscaling_config

end module test_river_upscaler

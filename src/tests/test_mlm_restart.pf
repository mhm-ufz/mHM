module test_mlm_restart
  use funit
  use mo_datetime, only: datetime, timedelta
  use mo_exchange_type, only: exchange_t
  use mo_grid_io, only: no_time
  use mo_kind, only: dp, i4, i8
  use mo_mlm_container, only: mlm_t
  use mo_netcdf, only: NcDataset, NcDimension, NcVariable
  use mo_points, only: cartesian, points_t

  implicit none
  private

  public :: test_mlm_restart_writes_static_metadata
  public :: test_mlm_restart_uses_input_order
  public :: test_mlm_legacy_restart_uses_input_metadata
  public :: test_mlm_restart_publishes_and_clears_metadata

contains

  @test
  subroutine test_mlm_restart_writes_static_metadata()
    type(exchange_t), target :: exchange
    type(points_t), target :: input_points
    type(mlm_t), target :: mlm
    type(NcDataset) :: nc
    type(NcVariable) :: var
    integer(i8), target :: ids(2)
    real(dp), target :: levels(2)
    integer(i8), allocatable :: restored_ids(:)
    real(dp), allocatable :: outlet_x(:), outlet_y(:), restored_levels(:), restored_outflow(:)
    integer(i4), allocatable :: coordsys
    character(64) :: timestamp
    integer :: status

    call setup_exchange(exchange, "2001-01-02 00:00:00")
    call input_points%init([100.0_dp, 200.0_dp], [300.0_dp, 400.0_dp], coordsys=cartesian)
    ids = [205_i8, 101_i8]
    levels = [25.0_dp, 10.0_dp]
    exchange%lake_points => input_points
    call exchange%lake_ids%publish_local("test", ids, no_time)
    call exchange%lake_max_levels%publish_local("test", levels, no_time)

    mlm%exchange => exchange
    call mlm%connect()
    mlm%outflow = [2.05_dp, 1.01_dp]
    mlm%write_restart = .true.
    mlm%restart_output_path = "mlm_restart_static_metadata.nc"
    exchange%time = datetime("2001-01-03 00:00:00")
    call mlm%finalize()

    nc = NcDataset("mlm_restart_static_metadata.nc", "r")
    @assertTrue(nc%hasVariable("lake_id"), message="mLM restart persists stable IDs")
    @assertTrue(nc%hasVariable("lake_outlet_x"), message="mLM restart persists outlet x coordinates")
    @assertTrue(nc%hasVariable("lake_outlet_y"), message="mLM restart persists outlet y coordinates")
    @assertTrue(nc%hasVariable("lake_max_level"), message="mLM restart persists maximum levels")
    @assertTrue(nc%hasVariable("lake_coordsys"), message="mLM restart persists coordinate system")
    @assertTrue(nc%hasVariable("lake_outflow"), message="mLM restart persists outflow")
    @assertTrue(nc%hasVariable("mlm_meta"), message="mLM restart persists timestamp metadata")
    var = nc%getVariable("lake_id"); call var%getData(restored_ids)
    var = nc%getVariable("lake_outlet_x"); call var%getData(outlet_x)
    var = nc%getVariable("lake_outlet_y"); call var%getData(outlet_y)
    var = nc%getVariable("lake_max_level"); call var%getData(restored_levels)
    var = nc%getVariable("lake_coordsys"); call var%getData(coordsys)
    var = nc%getVariable("lake_outflow"); call var%getData(restored_outflow)
    var = nc%getVariable("mlm_meta"); call var%getAttribute("time_stamp", timestamp)
    call nc%close()

    @assertEqual(ids, restored_ids, message="mLM restart keeps stable ID order")
    @assertEqual(input_points%x, outlet_x, tolerance=1.0e-12_dp)
    @assertEqual(input_points%y, outlet_y, tolerance=1.0e-12_dp)
    @assertEqual(levels, restored_levels, tolerance=1.0e-12_dp)
    @assertEqual(cartesian, coordsys, message="mLM restart keeps coordinate system")
    @assertEqual([2.05_dp, 1.01_dp], restored_outflow, tolerance=1.0e-12_dp)
    @assertEqual("2001-01-03 00:00:00", trim(timestamp), message="mLM restart timestamp is current domain time")

    call exchange%lake_ids%clear(owned=.true.)
    call exchange%lake_max_levels%clear(owned=.true.)
    nullify(exchange%lake_points)
  end subroutine test_mlm_restart_writes_static_metadata

  @test
  subroutine test_mlm_restart_uses_input_order()
    type(exchange_t), target :: exchange
    type(points_t), target :: input_points
    type(mlm_t), target :: mlm
    integer(i8), target :: input_ids(2)
    real(dp), target :: input_levels(2), inflow(2)

    call setup_exchange(exchange, "2001-01-02 00:00:00")
    call input_points%init([100.0_dp, 200.0_dp], [300.0_dp, 400.0_dp], coordsys=cartesian)
    input_ids = [205_i8, 101_i8]
    input_levels = [25.0_dp, 10.0_dp]
    inflow = 0.0_dp
    exchange%lake_points => input_points
    call exchange%lake_ids%publish_local("Input", input_ids, no_time)
    call exchange%lake_max_levels%publish_local("Input", input_levels, no_time)
    call exchange%lake_inflow%publish_local("mRM", inflow, 1_i4)
    call write_restart( &
      "mlm_restart_reordered_metadata.nc", [101_i8, 205_i8], [200.0_dp, 100.0_dp], [400.0_dp, 300.0_dp], &
      [10.0_dp, 25.0_dp], [1.01_dp, 2.05_dp], static_metadata=.true., timestamp="2001-01-02 00:00:00")

    mlm%exchange => exchange
    mlm%read_restart = .true.
    mlm%restart_input_path = "mlm_restart_reordered_metadata.nc"
    call mlm%connect()
    @assertEqual(input_ids, mlm%lake_ids, message="Input stable-ID ordering remains authoritative")
    @assertTrue(associated(exchange%lake_points, input_points), message="Input retains lake-point ownership")
    call mlm%initialize()
    @assertEqual([2.05_dp, 1.01_dp], mlm%outflow, tolerance=1.0e-12_dp, message="mLM restores outflow by stable ID rather than file order")
    call mlm%finalize()

    @assertTrue(exchange%lake_ids%provided, message="mLM finalization preserves Input-owned IDs")
    @assertTrue(exchange%lake_max_levels%provided, message="mLM finalization preserves Input-owned levels")
    @assertTrue(associated(exchange%lake_points, input_points), message="mLM finalization preserves Input-owned points")
    call clear_input_metadata(exchange)
    call exchange%lake_inflow%clear(owned=.true.)
  end subroutine test_mlm_restart_uses_input_order

  @test
  subroutine test_mlm_legacy_restart_uses_input_metadata()
    type(exchange_t), target :: exchange
    type(points_t), target :: input_points
    type(mlm_t), target :: mlm
    integer(i8), target :: input_ids(2)
    real(dp), target :: input_levels(2), inflow(2)

    call setup_exchange(exchange, "2001-01-02 00:00:00")
    call input_points%init([100.0_dp, 200.0_dp], [300.0_dp, 400.0_dp], coordsys=cartesian)
    input_ids = [205_i8, 101_i8]
    input_levels = [25.0_dp, 10.0_dp]
    inflow = 0.0_dp
    exchange%lake_points => input_points
    call exchange%lake_ids%publish_local("Input", input_ids, no_time)
    call exchange%lake_max_levels%publish_local("Input", input_levels, no_time)
    call exchange%lake_inflow%publish_local("mRM", inflow, 1_i4)
    call write_restart( &
      "mlm_restart_legacy.nc", [101_i8, 205_i8], [0.0_dp, 0.0_dp], [0.0_dp, 0.0_dp], [0.0_dp, 0.0_dp], &
      [1.01_dp, 2.05_dp], static_metadata=.false.)

    mlm%exchange => exchange
    mlm%read_restart = .true.
    mlm%restart_input_path = "mlm_restart_legacy.nc"
    call mlm%connect()
    @assertFalse(mlm%restart_has_static_metadata, message="legacy restart remains recognizable")
    @assertEqual(input_ids, mlm%lake_ids, message="legacy restart uses Input stable-ID ordering")
    call mlm%initialize()
    @assertEqual([2.05_dp, 1.01_dp], mlm%outflow, tolerance=1.0e-12_dp)
    call mlm%finalize()

    @assertTrue(exchange%lake_ids%provided, message="legacy restart does not claim Input metadata")
    call clear_input_metadata(exchange)
    call exchange%lake_inflow%clear(owned=.true.)
  end subroutine test_mlm_legacy_restart_uses_input_metadata

  @test
  subroutine test_mlm_restart_publishes_and_clears_metadata()
    type(exchange_t), target :: exchange
    type(mlm_t), target :: mlm

    call setup_exchange(exchange, "2001-01-02 00:00:00")
    call write_restart( &
      "mlm_restart_owned_metadata.nc", [101_i8, 205_i8], [200.0_dp, 100.0_dp], [400.0_dp, 300.0_dp], &
      [10.0_dp, 25.0_dp], [1.01_dp, 2.05_dp], static_metadata=.true., timestamp="2001-01-02 00:00:00")

    mlm%exchange => exchange
    mlm%read_restart = .true.
    mlm%restart_input_path = "mlm_restart_owned_metadata.nc"
    call mlm%connect()
    @assertTrue(associated(exchange%lake_points, mlm%static_lake_points), message="mLM publishes restart lake points")
    @assertEqual([101_i8, 205_i8], exchange%lake_ids%data, message="mLM publishes restart stable IDs")
    @assertEqual([10.0_dp, 25.0_dp], exchange%lake_max_levels%data, tolerance=1.0e-12_dp)
    call mlm%finalize()

    @assertFalse(exchange%lake_ids%provided, message="mLM clears its stable-ID publication")
    @assertFalse(exchange%lake_max_levels%provided, message="mLM clears its maximum-level publication")
    @assertFalse(associated(exchange%lake_points), message="mLM clears its point publication")
  end subroutine test_mlm_restart_publishes_and_clears_metadata

  subroutine setup_exchange(exchange, start_time)
    type(exchange_t), target, intent(inout) :: exchange
    character(*), intent(in) :: start_time
    integer :: status

    status = exchange%config%project%set()
    @assertEqual(0, status, message="project defaults configure mLM restart exchange")
    call exchange%create(cwd=".")
    exchange%start_time = datetime(start_time)
    exchange%time = exchange%start_time
    exchange%step = timedelta(hours=1_i4)
    exchange%step_hours = 1_i4
  end subroutine setup_exchange

  subroutine clear_input_metadata(exchange)
    type(exchange_t), target, intent(inout) :: exchange

    call exchange%lake_ids%clear(owned=.true.)
    call exchange%lake_max_levels%clear(owned=.true.)
    nullify(exchange%lake_points)
  end subroutine clear_input_metadata

  subroutine write_restart(path, ids, outlet_x, outlet_y, levels, outflow, static_metadata, timestamp)
    character(*), intent(in) :: path
    integer(i8), intent(in) :: ids(:)
    real(dp), intent(in) :: outlet_x(:), outlet_y(:), levels(:), outflow(:)
    logical, intent(in) :: static_metadata
    character(*), optional, intent(in) :: timestamp
    type(NcDataset) :: nc
    type(NcDimension) :: dims(0), lake_dim
    type(NcVariable) :: var

    nc = NcDataset(path, "w")
    lake_dim = nc%setDimension("lake", int(size(ids), i4))
    var = nc%setVariable("lake_id", "i64", [lake_dim])
    call var%setData(ids)
    if (static_metadata) then
      var = nc%setVariable("lake_outlet_x", "f64", [lake_dim])
      call var%setData(outlet_x)
      var = nc%setVariable("lake_outlet_y", "f64", [lake_dim])
      call var%setData(outlet_y)
      var = nc%setVariable("lake_max_level", "f64", [lake_dim])
      call var%setData(levels)
      var = nc%setVariable("lake_coordsys", "i32", dims(:0))
      call var%setData(cartesian)
    end if
    var = nc%setVariable("lake_outflow", "f64", [lake_dim])
    call var%setData(outflow)
    if (present(timestamp)) then
      var = nc%setVariable("mlm_meta", "i32", dims(:0))
      call var%setData(0_i4)
      call var%setAttribute("time_stamp", timestamp)
    end if
    call nc%close()
  end subroutine write_restart

end module test_mlm_restart

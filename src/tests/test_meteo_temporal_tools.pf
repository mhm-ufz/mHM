module test_meteo_temporal_tools
  use funit
  use mo_datetime, only: datetime
  use mo_netcdf, only: NcDataset, NcVariable, NcDimension
  use mo_exchange_type, only: exchange_t
  use mo_grid, only: grid_t, bottom_up, spherical
  use mo_meteo_temporal_tools
  use mo_meteo_container, only: meteo_t, meteo_is_day_step, meteo_supports_model_step, meteo_supports_forcing_step
  use mo_grid_io, only: daily, monthly, yearly, no_time
  use mo_kind, only: dp, i4, i8

  implicit none

  private

  public :: test_temporal_disagg_meteo_weights
  public :: test_temporal_disagg_flux_daynight
  public :: test_temporal_disagg_state_daynight
  public :: test_interval_start_daynight_window
  public :: test_supported_model_steps
  public :: test_active_meteo_supported_steps
  public :: test_lake_passthrough_meteo_noop
  public :: test_lake_forcing_aggregates_l2_support
  public :: test_lake_forcing_disaggregates_daily
  public :: test_forcing_step_compatibility
  public :: test_tann_supported_steps
  public :: test_count_weighted_container

  real(dp) :: t = 0.001_dp

contains

  @test
  !> \brief Real container remapping must count cells even when spherical cell areas differ.
  subroutine test_count_weighted_container()
    type(exchange_t), target :: exchange
    type(grid_t), target :: fine, coarse
    type(meteo_t) :: meteo
    type(NcDataset) :: nc
    type(NcVariable) :: variable
    type(NcDimension) :: dims(4)
    real(dp) :: weights(2,2,12,24)
    real(dp), target :: forcing(4)
    real(dp) :: expected, area_mean
    integer :: step, status, i
    do i = 1, 3
      step = 1
      if (i == 2) step = 24
      status = exchange%config%project%set()
      @assertEqual(0, status)
      call exchange%create(cwd='.')
      exchange%cwd = exchange%root
      status = exchange%config%processes%set(direct_runoff=1_i4)
      @assertEqual(0, status)
      exchange%step_hours = step
      exchange%time_step_start = datetime('2001-01-02 00:00:00')
      call fine%init(2_i4, 2_i4, yllcorner=40.0_dp, cellsize=10.0_dp, coordsys=spherical)
      call coarse%init(1_i4, 1_i4, yllcorner=40.0_dp, cellsize=20.0_dp, coordsys=spherical)
      exchange%level0_land => fine
      exchange%level0 => fine
      exchange%level1_land => coarse
      exchange%level2 => fine
      forcing = [0.0_dp, 0.0_dp, 12.0_dp, 12.0_dp]
      area_mean = sum(forcing * fine%cell_area) / sum(fine%cell_area)
      @assertTrue(abs(area_mean - 6.0_dp) > 0.1_dp)
      call exchange%raw_pre%provide('test')
      call exchange%raw_pre%prepare_data('test', daily)
      exchange%raw_pre%data => forcing
      status = meteo%config%set(frac_night_pre=reshape(spread(0.5_dp,1,12), [12,1]))
      @assertEqual(0, status)
      if (i == 3) then
        weights = 0.0_dp
        weights(:,1,:,1) = 1.0_dp
        weights(:,2,:,2) = 1.0_dp
        nc = NcDataset('count_weights.nc','w')
        dims(1) = nc%setDimension('x',2)
        dims(2) = nc%setDimension('y',2)
        dims(3) = nc%setDimension('month',12)
        dims(4) = nc%setDimension('hour',24)
        variable = nc%setVariable('pre_weights','f64',dims)
        call variable%setAttribute('missing_value',-9999.0_dp)
        call variable%setData(weights)
        call nc%close()
        status = meteo%config%set(read_meteo_weights=[.true.],pre_weights_path=[character(256) :: 'count_weights.nc'])
        @assertEqual(0,status)
      end if
      meteo%exchange => exchange
      call meteo%configure()
      call meteo%connect()
      call meteo%initialize()
      call meteo%update()
      expected = 6.0_dp * real(step,dp) / 24.0_dp
      if (i == 3) expected = 3.0_dp
      @assertEqual(expected, exchange%pre%data(1), tolerance=1.e-12_dp)
      call exchange%destroy()
      call meteo%destroy()
      call fine%destroy()
      call coarse%destroy()
    end do
  end subroutine test_count_weighted_container

  @test
  subroutine test_supported_model_steps()
    @assertTrue(meteo_supports_model_step(1), message='meteo accepts hourly model steps')
    @assertTrue(meteo_supports_model_step(24), message='meteo accepts daily model steps')
    @assertFalse(meteo_supports_model_step(4), message='meteo rejects intermediate model steps')
  end subroutine test_supported_model_steps

  @test
  subroutine test_forcing_step_compatibility()
    @assertTrue(meteo_supports_forcing_step(24, daily), message='daily forcing supports a daily model step')
    @assertTrue(meteo_supports_forcing_step(24, 24), message='fixed 24-hour forcing supports a daily model step')
    @assertFalse(meteo_supports_forcing_step(24, 1), message='hourly forcing requires aggregation for a daily model step')
    @assertTrue(meteo_supports_forcing_step(1, 1), message='hourly forcing supports an hourly model step')
    @assertFalse(meteo_supports_forcing_step(1, 6), message='coarser fixed forcing requires resampling for an hourly model step')
  end subroutine test_forcing_step_compatibility

  @test
  !> \brief Accept all supported annual-temperature cadences on hourly and daily models.
  subroutine test_tann_supported_steps()
    integer(i4), parameter :: model_steps(2) = [1_i4, 24_i4]
    integer(i4) :: model_step, model_index, cadence
    integer(i4) :: steps(5)

    do model_index = 1_i4, size(model_steps)
      model_step = model_steps(model_index)
      steps = [no_time, daily, monthly, yearly, model_step]
      do cadence = 1_i4, size(steps)
        call check_tann_cadence(model_step, steps(cadence))
      end do
    end do
  end subroutine test_tann_supported_steps

  !> \brief Exercise the real meteo connection and forward supplied annual means without disaggregation.
  subroutine check_tann_cadence(model_step, forcing_step)
    integer(i4), intent(in) :: model_step !< Hourly or daily model cadence.
    integer(i4), intent(in) :: forcing_step !< Native annual-temperature input cadence.
    type(exchange_t), target :: exchange
    type(grid_t), target :: grid
    type(meteo_t) :: meteo
    real(dp), target :: forcing(2), tann(2)
    real(dp), pointer :: publication(:)
    integer :: status

    status = exchange%config%project%set()
    @assertEqual(0, status)
    call exchange%create(cwd='.')
    exchange%step_hours = model_step
    exchange%time_step_start = datetime('2001-12-31 00:00:00')
    status = exchange%config%processes%set(temperature_routing=1_i4)
    @assertEqual(0, status)
    call grid%init(2_i4, 1_i4, cellsize=1.0_dp)
    exchange%level0 => grid
    exchange%level0_land => grid
    exchange%level1_land => grid
    exchange%level2 => grid
    forcing = [10.0_dp, 20.0_dp]
    tann = [7.0_dp, 9.0_dp]
    call exchange%raw_pre%provide('test')
    call exchange%raw_pre%prepare_data('test', model_step)
    exchange%raw_pre%data => forcing
    call exchange%raw_temp%provide('test')
    call exchange%raw_temp%prepare_data('test', model_step)
    exchange%raw_temp%data => forcing
    call exchange%raw_ssrd%provide('test')
    call exchange%raw_ssrd%prepare_data('test', model_step)
    exchange%raw_ssrd%data => forcing
    call exchange%raw_strd%provide('test')
    call exchange%raw_strd%prepare_data('test', model_step)
    exchange%raw_strd%data => forcing
    call exchange%raw_tann%provide('test')
    exchange%raw_tann%static = forcing_step == no_time
    call exchange%raw_tann%prepare_data('test', forcing_step)
    exchange%raw_tann%data => tann
    status = meteo%config%set()
    @assertEqual(0, status)
    meteo%exchange => exchange
    call meteo%configure()
    call meteo%connect()
    call meteo%initialize()
    publication => exchange%tann%data
    call meteo%update()
    @assertEqual(tann, exchange%tann%data, tolerance=1.e-12_dp, message='annual mean is forwarded without temporal scaling')
    @assertEqual(model_step, exchange%tann%stepping, message='published annual mean represents the model step')
    if (forcing_step /= no_time) then
      exchange%time_step_start = datetime('2002-01-01 00:00:00')
      tann = [8.0_dp, 10.0_dp]
      call meteo%update()
      @assertEqual(tann, exchange%tann%data, tolerance=1.e-12_dp, message='updated annual mean is forwarded across the year boundary')
      @assertTrue(associated(publication, exchange%tann%data), message='annual-temperature publication stays at a stable target')
    end if
    call exchange%destroy()
    call meteo%destroy()
    call grid%destroy()
  end subroutine check_tann_cadence

  @test
  subroutine test_active_meteo_supported_steps()
    type(exchange_t), target :: hourly_exchange
    type(exchange_t), target :: daily_exchange
    type(meteo_t) :: hourly_meteo
    type(meteo_t) :: daily_meteo
    integer :: status

    status = hourly_exchange%config%processes%set(snow=1)
    @assertEqual(0, status)
    status = hourly_meteo%config%set()
    @assertEqual(0, status)
    hourly_exchange%step_hours = 1
    hourly_meteo%exchange => hourly_exchange
    call hourly_meteo%configure()
    @assertTrue(hourly_meteo%active, message='active meteo configures for an hourly model step')

    status = daily_exchange%config%processes%set(snow=1)
    @assertEqual(0, status)
    status = daily_meteo%config%set()
    @assertEqual(0, status)
    daily_exchange%step_hours = 24
    daily_meteo%exchange => daily_exchange
    call daily_meteo%configure()
    @assertTrue(daily_meteo%active, message='active meteo configures for a daily model step')
  end subroutine test_active_meteo_supported_steps

  @test
  subroutine test_lake_passthrough_meteo_noop()
    type(exchange_t), target :: exchange
    type(meteo_t) :: meteo
    integer :: status

    status = exchange%config%processes%set(lake=-1)
    @assertEqual(0, status)
    status = meteo%config%set()
    @assertEqual(0, status)
    exchange%step_hours = 1
    meteo%exchange => exchange
    call meteo%configure()
    @assertTrue(meteo%active, message='a pass-through lake activates meteo lifecycle participation')
    call meteo%connect()
    call meteo%initialize()
    call meteo%finalize()
    call exchange%destroy()
    call meteo%destroy()
  end subroutine test_lake_passthrough_meteo_noop

  @test
  subroutine test_lake_forcing_aggregates_l2_support()
    type(exchange_t), target :: exchange
    type(grid_t), target :: level0_lake, level2
    type(meteo_t) :: meteo
    integer(i8), target :: lake_ids(2), lake_map(4)
    real(dp), target :: lake_spill_reference_surface_area_dem_derived(2), raw_pre(2), raw_pet(2), raw_temp(2), raw_ssrd(2), raw_strd(2), raw_tann(2)
    integer :: status

    status = exchange%config%project%set()
    @assertEqual(0, status)
    call exchange%create(cwd='.')
    exchange%step_hours = 1_i4
    exchange%time_step_start = datetime('2001-01-02 00:00:00')
    status = exchange%config%processes%set(lake=-2_i4)
    @assertEqual(0, status)
    call level0_lake%init(4_i4, 1_i4, cellsize=1.0_dp, y_direction=bottom_up)
    call level2%init(2_i4, 1_i4, cellsize=2.0_dp, y_direction=bottom_up)
    exchange%level0_lake => level0_lake
    exchange%level2 => level2
    lake_ids = [10_i8, 20_i8]
    lake_map = [10_i8, 20_i8, 10_i8, 20_i8]
    lake_spill_reference_surface_area_dem_derived = [2.0_dp, 2.0_dp]
    raw_pre = [4.0_dp, 8.0_dp]
    raw_pet = [1.0_dp, 3.0_dp]
    raw_temp = [10.0_dp, 14.0_dp]
    raw_ssrd = [100.0_dp, 200.0_dp]
    raw_strd = [300.0_dp, 400.0_dp]
    raw_tann = [7.0_dp, 9.0_dp]
    call exchange%lake_ids%provide('test')
    call exchange%lake_ids%prepare_data('test', no_time)
    exchange%lake_ids%data => lake_ids
    call exchange%lake_map%provide('test')
    call exchange%lake_map%prepare_data('test', no_time)
    exchange%lake_map%data => lake_map
    call exchange%lake_spill_reference_surface_area_dem_derived%provide('test')
    call exchange%lake_spill_reference_surface_area_dem_derived%prepare_data('test', no_time)
    exchange%lake_spill_reference_surface_area_dem_derived%data => lake_spill_reference_surface_area_dem_derived
    call exchange%raw_pre%provide('test')
    call exchange%raw_pre%prepare_data('test', 1_i4)
    exchange%raw_pre%data => raw_pre
    call exchange%raw_pet%provide('test')
    call exchange%raw_pet%prepare_data('test', 1_i4)
    exchange%raw_pet%data => raw_pet
    call exchange%raw_temp%provide('test')
    call exchange%raw_temp%prepare_data('test', 1_i4)
    exchange%raw_temp%data => raw_temp
    call exchange%raw_ssrd%provide('test')
    call exchange%raw_ssrd%prepare_data('test', 1_i4)
    exchange%raw_ssrd%data => raw_ssrd
    call exchange%raw_strd%provide('test')
    call exchange%raw_strd%prepare_data('test', 1_i4)
    exchange%raw_strd%data => raw_strd
    call exchange%raw_tann%provide('test')
    call exchange%raw_tann%prepare_data('test', 1_i4)
    exchange%raw_tann%data => raw_tann
    status = meteo%config%set()
    @assertEqual(0, status)
    meteo%exchange => exchange
    call meteo%configure()
    call meteo%connect()
    call meteo%initialize()
    call meteo%update()
    @assertEqual([6.0_dp, 6.0_dp], exchange%lake_pre%data, tolerance=t, message='lake precipitation averages its two touched level2 cells')
    @assertEqual([2.0_dp, 2.0_dp], exchange%lake_pet%data, tolerance=t, message='lake PET averages its two touched level2 cells')
    @assertFalse(exchange%lake_temp%provided, message='lake temperature is not forwarded without a lake consumer')
    @assertFalse(exchange%lake_ssrd%provided, message='lake short-wave radiation is not forwarded without a lake consumer')
    @assertFalse(exchange%lake_strd%provided, message='lake long-wave radiation is not forwarded without a lake consumer')
    @assertFalse(exchange%lake_tann%provided, message='lake annual temperature is not forwarded without a lake consumer')
    call meteo%finalize()
    call exchange%destroy()
    call meteo%destroy()
  end subroutine test_lake_forcing_aggregates_l2_support

  @test
  subroutine test_lake_forcing_disaggregates_daily()
    type(exchange_t), target :: exchange
    type(grid_t), target :: level0_lake, level2
    type(meteo_t) :: meteo
    integer(i8), target :: lake_ids(1), lake_map(2)
    real(dp), target :: lake_spill_reference_surface_area_dem_derived(1), raw_pre(1), raw_pet(1)
    real(dp) :: night_fraction(12, 1)
    integer :: status

    status = exchange%config%project%set()
    @assertEqual(0, status)
    call exchange%create(cwd='.')
    exchange%step_hours = 1_i4
    exchange%time_step_start = datetime('2001-01-02 00:00:00')
    status = exchange%config%processes%set(lake=-2_i4)
    @assertEqual(0, status)
    call level0_lake%init(2_i4, 1_i4, cellsize=1.0_dp, y_direction=bottom_up)
    call level2%init(1_i4, 1_i4, cellsize=2.0_dp, y_direction=bottom_up)
    exchange%level0_lake => level0_lake
    exchange%level2 => level2
    lake_ids = [10_i8]
    lake_map = [10_i8, 10_i8]
    lake_spill_reference_surface_area_dem_derived = [2.0_dp]
    raw_pre = [6.0_dp]
    raw_pet = [2.0_dp]
    night_fraction = 0.5_dp
    call exchange%lake_ids%provide('test')
    call exchange%lake_ids%prepare_data('test', no_time)
    exchange%lake_ids%data => lake_ids
    call exchange%lake_map%provide('test')
    call exchange%lake_map%prepare_data('test', no_time)
    exchange%lake_map%data => lake_map
    call exchange%lake_spill_reference_surface_area_dem_derived%provide('test')
    call exchange%lake_spill_reference_surface_area_dem_derived%prepare_data('test', no_time)
    exchange%lake_spill_reference_surface_area_dem_derived%data => lake_spill_reference_surface_area_dem_derived
    call exchange%raw_pre%provide('test')
    call exchange%raw_pre%prepare_data('test', daily)
    exchange%raw_pre%data => raw_pre
    call exchange%raw_pet%provide('test')
    call exchange%raw_pet%prepare_data('test', daily)
    exchange%raw_pet%data => raw_pet
    status = meteo%config%set(frac_night_pre=night_fraction, frac_night_pet=night_fraction)
    @assertEqual(0, status)
    meteo%exchange => exchange
    call meteo%configure()
    call meteo%connect()
    call meteo%initialize()
    call meteo%update()
    @assertEqual([0.25_dp], exchange%lake_pre%data, tolerance=t, message='daily lake precipitation is distributed across nightly hours')
    @assertEqual([1.0_dp / 12.0_dp], exchange%lake_pet%data, tolerance=t, message='daily lake PET is distributed across nightly hours')
    call meteo%finalize()
    call exchange%destroy()
    call meteo%destroy()
  end subroutine test_lake_forcing_disaggregates_daily

  @test
  subroutine test_interval_start_daynight_window()
    integer :: day_steps
    integer :: hour

    @assertFalse(meteo_is_day_step(6), message='the interval starting at 06:00 remains a night interval')
    @assertTrue(meteo_is_day_step(7), message='the interval starting at 07:00 is the first legacy day interval')
    @assertTrue(meteo_is_day_step(18), message='the interval starting at 18:00 is the last legacy day interval')
    @assertFalse(meteo_is_day_step(19), message='the interval starting at 19:00 is a night interval')
    day_steps = 0
    do hour = 0, 23
      if (meteo_is_day_step(hour)) day_steps = day_steps + 1
    end do
    @assertEqual(12, day_steps, message='the legacy day/night split must keep twelve hourly day intervals')
  end subroutine test_interval_start_daynight_window

  @test
  subroutine test_temporal_disagg_meteo_weights()

    real(dp), dimension(2) :: ref_meteo_val
    real(dp), dimension(2) :: res_meteo_val

    ref_meteo_val = [0.822_dp, 0.996_dp]

    call temporal_disagg_meteo_weights([2.74_dp, 3.32_dp], 0.3_dp, res_meteo_val)
    @assertEqual(ref_meteo_val, res_meteo_val, tolerance=t, message='temporal_disagg_meteo_weights: without weights_correction')

    ref_meteo_val = [0.472_dp, 0.646_dp]

    call temporal_disagg_meteo_weights([2.74_dp, 3.32_dp], 0.3_dp, res_meteo_val, 0.5_dp)
    @assertEqual(ref_meteo_val, res_meteo_val, tolerance=t, message='temporal_disagg_meteo_weights: with weights_correction')

  end subroutine test_temporal_disagg_meteo_weights

  @test
  subroutine test_temporal_disagg_flux_daynight()

    real(dp), dimension(3) :: ref_meteo_val
    real(dp), dimension(3) :: res_meteo_val

    ref_meteo_val = [0.2055_dp, 0.0228_dp, 2.74_dp]

    call temporal_disagg_flux_daynight([.true., .false., .true.], [24.0_dp, 24.0_dp, 1.0_dp], &
                                       2.74_dp, 0.9_dp, 0.1_dp, res_meteo_val)
    @assertEqual(ref_meteo_val, res_meteo_val, tolerance=t, message='temporal_disagg_flux_daynight')

  end subroutine test_temporal_disagg_flux_daynight

  @test
  subroutine test_temporal_disagg_state_daynight()

    real(dp), dimension(5) :: ref_meteo_val
    real(dp), dimension(5) :: res_meteo_val

    ref_meteo_val = [4.932_dp, 0.548_dp, 3.64_dp, 2.84_dp, 2.74_dp]

    call temporal_disagg_state_daynight([.true., .false., .true., .false., .true.], [24.0_dp, 24.0_dp, 24.0_dp, 24.0_dp, 1.0_dp], &
                                        2.74_dp, 0.9_dp, 0.1_dp, res_meteo_val, [.false., .false., .true., .true., .false.])
    @assertEqual(ref_meteo_val, res_meteo_val, tolerance=t, message='temporal_disagg_state_daynight')

  end subroutine test_temporal_disagg_state_daynight

end module test_meteo_temporal_tools
